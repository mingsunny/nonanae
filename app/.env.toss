# 토스 미니앱 빌드(`npm run build:toss` = `vite build --mode toss`)에서만 읽힌다. 비밀값은 넣지 않는다.
# Supabase 주소·키(VITE_SUPABASE_URL 등)는 웹과 같이 .env.local에서 읽는다.
VITE_TARGET=toss
# apps-in-toss.config.ts의 appName과 같은 값 (초대 링크 intoss://{appName}/join?code=... 에 쓰임)
VITE_TOSS_APP_NAME=nonanae
# 토스 미니앱에는 봇 확인(Turnstile, 외부 iframe)을 쓰지 않는다 — 이메일 가입·로그인이 없어서 필요도 없다
VITE_TURNSTILE_SITE_KEY=
