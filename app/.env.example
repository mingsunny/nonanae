# 이 파일을 복사해서 `.env.local`을 만들고 값을 채운다 (`.env.local`은 git에 올라가지 않는다).
#   cp .env.example .env.local
# 값은 Supabase 대시보드 → Project Settings → API Keys 에서 확인.
# 주의: 여기에는 URL과 publishable(anon) 키만 넣는다. secret / service_role 키는 절대 넣지 않는다.

# true로 바꾸면 목업 DB 대신 Supabase에 연결한다. 비워두면 목업(localStorage)으로 동작.
VITE_USE_SUPABASE=false

VITE_SUPABASE_URL=https://프로젝트번호.supabase.co
VITE_SUPABASE_ANON_KEY=
